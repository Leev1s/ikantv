<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- VLC 官方布局容器：内部由 VideoHelper 按视频 DAR 计算摆放（SURFACE_BEST_FIT），
         裸 SurfaceView 无参 attach 时没有任何几何管理，画面会被解码器/SurfaceFlinger
         的填充口径裁切——必须用 VLCVideoLayout + MediaPlayer.attachViews 接管 -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部信息条 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B3101216"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#FFB300"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/player_clock" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="top|right"
        android:layout_marginTop="18dp" android:layout_marginRight="28dp"
        android:textColor="#C9CDD2" android:textSize="16sp" android:visibility="gone" />

    <!-- 中央播放/暂停指示 -->
    <TextView
        android:id="@+id/center_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/hint_bg"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:visibility="gone" />

    <!-- 中央 OSD（快进/续播/倍速提示） -->
    <TextView
        android:id="@+id/osd_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="86dp"
        android:background="@drawable/hint_bg"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:visibility="gone" />

    <!-- 底部控制条 -->
    <LinearLayout
        android:id="@+id/controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3101216"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:id="@+id/video_stats" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#C9CDD2" android:textSize="14sp" />
            <TextView android:id="@+id/audio_stats" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:gravity="right"
                android:textColor="#C9CDD2" android:textSize="14sp" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:progressDrawable="@drawable/seek_progress"
            android:thumb="@null" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OK 播放/暂停 · ◀▶ 快进退 · ▲ 选集 · ▼ 换源"
                android:textColor="#9AA0A6"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 加载遮罩 -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60B0D10"
        android:gravity="center"
        android:orientation="vertical">
        <ProgressBar
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:indeterminateDrawable="@drawable/loading_ring" />
        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:textColor="#FFFFFF"
            android:textSize="19sp" />
    </LinearLayout>

    <!-- 右侧面板：选集 / 换源 -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="#F216181D"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="12dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/panel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
        <GridView
            android:id="@+id/ep_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="3"
            android:horizontalSpacing="6dp"
            android:verticalSpacing="6dp"
            android:listSelector="@drawable/list_selector"
            android:drawSelectorOnTop="true" />
        <ListView
            android:id="@+id/line_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#262A31"
            android:dividerHeight="1dp"
            android:listSelector="@drawable/list_selector"
            android:drawSelectorOnTop="true"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
