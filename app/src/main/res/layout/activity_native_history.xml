<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/history_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:background="#101216">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:orientation="vertical">

        <!-- 顶栏第一行：全站统一标签栏（当前页「看过」由标签描边高亮） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="48dp"
            android:paddingRight="48dp"
            android:paddingTop="18dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="爱看电视"
                android:textColor="#E8EAED"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/history_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 顶栏第二行：清空历史（靠右） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="48dp"
            android:paddingRight="48dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/history_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_frame"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="清空历史"
                android:textColor="@color/chip_text"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/history_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="true">

            <LinearLayout
                android:id="@+id/history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingLeft="48dp"
                android:paddingRight="48dp"
                android:paddingTop="10dp"
                android:paddingBottom="16dp" />
        </ScrollView>
    </LinearLayout>

    <!-- 空态文案：本身是焦点落点且可点（OK = 回首页），套 card_frame
         琥珀描边保证焦点可见（UX 评审 C1） -->
    <TextView
        android:id="@+id/history_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/card_frame"
        android:clickable="true"
        android:focusable="true"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="还没看过什么，去首页挑一部吧"
        android:textColor="#E8EAED"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
